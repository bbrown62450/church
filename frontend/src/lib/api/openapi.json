{
  "components": {
    "schemas": {
      "ChurchOut": {
        "properties": {
          "id": {
            "format": "uuid",
            "title": "Id",
            "type": "string"
          },
          "name": {
            "title": "Name",
            "type": "string"
          },
          "role": {
            "enum": [
              "owner",
              "admin",
              "member"
            ],
            "title": "Role",
            "type": "string"
          }
        },
        "required": [
          "id",
          "name",
          "role"
        ],
        "title": "ChurchOut",
        "type": "object"
      },
      "ErrorBody": {
        "description": "Every error response's body (F \u00a71.5). `fields` and `details` are left out when absent.",
        "properties": {
          "error": {
            "$ref": "#/components/schemas/ErrorDetail"
          }
        },
        "required": [
          "error"
        ],
        "title": "ErrorBody",
        "type": "object"
      },
      "ErrorDetail": {
        "properties": {
          "code": {
            "title": "Code",
            "type": "string"
          },
          "details": {
            "anyOf": [
              {
                "additionalProperties": true,
                "type": "object"
              },
              {
                "type": "null"
              }
            ],
            "title": "Details"
          },
          "fields": {
            "anyOf": [
              {
                "additionalProperties": {
                  "type": "string"
                },
                "type": "object"
              },
              {
                "type": "null"
              }
            ],
            "title": "Fields"
          },
          "message": {
            "title": "Message",
            "type": "string"
          },
          "request_id": {
            "title": "Request Id",
            "type": "string"
          }
        },
        "required": [
          "code",
          "message",
          "request_id"
        ],
        "title": "ErrorDetail",
        "type": "object"
      },
      "MeOut": {
        "properties": {
          "churches": {
            "items": {
              "$ref": "#/components/schemas/ChurchOut"
            },
            "title": "Churches",
            "type": "array"
          },
          "user": {
            "$ref": "#/components/schemas/UserOut"
          }
        },
        "required": [
          "user",
          "churches"
        ],
        "title": "MeOut",
        "type": "object"
      },
      "ReadyOut": {
        "properties": {
          "db": {
            "const": "ok",
            "title": "Db",
            "type": "string"
          },
          "ok": {
            "title": "Ok",
            "type": "boolean"
          }
        },
        "required": [
          "ok",
          "db"
        ],
        "title": "ReadyOut",
        "type": "object"
      },
      "RubricModel": {
        "properties": {
          "hymns": {
            "additionalProperties": {
              "items": {
                "type": "string"
              },
              "type": "array"
            },
            "title": "Hymns",
            "type": "object"
          },
          "prayers": {
            "additionalProperties": {
              "items": {
                "type": "string"
              },
              "type": "array"
            },
            "title": "Prayers",
            "type": "object"
          },
          "prefer_before_year": {
            "title": "Prefer Before Year",
            "type": "integer"
          },
          "prefer_familiar": {
            "title": "Prefer Familiar",
            "type": "boolean"
          }
        },
        "required": [
          "hymns",
          "prayers",
          "prefer_before_year",
          "prefer_familiar"
        ],
        "title": "RubricModel",
        "type": "object"
      },
      "RubricOut": {
        "properties": {
          "customized": {
            "items": {
              "type": "string"
            },
            "title": "Customized",
            "type": "array"
          },
          "rubric": {
            "$ref": "#/components/schemas/RubricModel"
          }
        },
        "required": [
          "rubric",
          "customized"
        ],
        "title": "RubricOut",
        "type": "object"
      },
      "UserOut": {
        "properties": {
          "email": {
            "title": "Email",
            "type": "string"
          },
          "id": {
            "format": "uuid",
            "title": "Id",
            "type": "string"
          },
          "name": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Name"
          },
          "picture": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Picture"
          }
        },
        "required": [
          "id",
          "email"
        ],
        "title": "UserOut",
        "type": "object"
      }
    }
  },
  "info": {
    "title": "Worship Service Builder API",
    "version": "0.1.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/church": {
      "get": {
        "operationId": "church_church_get",
        "parameters": [
          {
            "in": "header",
            "name": "x-church-id",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "X-Church-Id"
            }
          },
          {
            "in": "header",
            "name": "authorization",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Authorization"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ChurchOut"
                }
              }
            },
            "description": "Successful Response"
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            },
            "description": "Unauthorized"
          },
          "403": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            },
            "description": "Forbidden"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            },
            "description": "Unprocessable Entity"
          },
          "503": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            },
            "description": "Service Unavailable"
          }
        },
        "summary": "Church"
      }
    },
    "/health": {
      "get": {
        "description": "Liveness: never touches the database. Railway's deploy health check is /health/ready (railway.toml).",
        "operationId": "health_health_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": true,
                  "title": "Response Health Health Get",
                  "type": "object"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Health"
      }
    },
    "/health/ready": {
      "get": {
        "description": "Readiness (Railway's deploy health check and keepalive.yml): 503 db_unavailable\nwhen, in production, the schema is behind this release, or when the database\nis not reachable. `ahead`, `unknown` and an unset state (no lifespan) pass.",
        "operationId": "ready_health_ready_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ReadyOut"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Ready"
      }
    },
