{
  "components": {
    "schemas": {
      "ChurchOut": {
        "properties": {
          "id": {
            "format": "uuid",
            "title": "Id",
            "type": "string"
          },
          "name": {
            "title": "Name",
            "type": "string"
          },
          "role": {
            "enum": [
              "owner",
              "admin",
              "member"
            ],
            "title": "Role",
            "type": "string"
          }
        },
        "required": [
          "id",
          "name",
          "role"
        ],
        "title": "ChurchOut",
        "type": "object"
      },
      "CreateChurchIn": {
        "additionalProperties": false,
        "description": "The body of POST /churches. A blank name, or a blank or unknown time\nzone, passes this model and gets a 422 that names the field.",
        "properties": {
          "name": {
            "default": "",
            "maxLength": 200,
            "title": "Name",
            "type": "string"
          },
          "timezone": {
            "default": "",
            "maxLength": 64,
            "title": "Timezone",
            "type": "string"
          }
        },
        "title": "CreateChurchIn",
        "type": "object"
      },
      "ErrorBody": {
        "description": "Every error response's body (F \u00a71.5). `fields` and `details` are left out when absent.",
        "properties": {
          "error": {
            "$ref": "#/components/schemas/ErrorDetail"
          }
        },
        "required": [
          "error"
        ],
        "title": "ErrorBody",
        "type": "object"
      },
      "ErrorDetail": {
        "properties": {
          "code": {
            "title": "Code",
            "type": "string"
          },
          "details": {
            "anyOf": [
              {
                "additionalProperties": true,
                "type": "object"
              },
              {
                "type": "null"
              }
            ],
            "title": "Details"
          },
          "fields": {
            "anyOf": [
              {
                "additionalProperties": {
                  "type": "string"
                },
                "type": "object"
              },
              {
                "type": "null"
              }
            ],
            "title": "Fields"
          },
          "message": {
            "title": "Message",
            "type": "string"
          },
          "request_id": {
            "title": "Request Id",
            "type": "string"
          }
        },
        "required": [
          "code",
          "message",
          "request_id"
        ],
        "title": "ErrorDetail",
        "type": "object"
      },
      "InviteAcceptOut": {
        "properties": {
          "already_member": {
            "title": "Already Member",
            "type": "boolean"
          },
          "church": {
            "$ref": "#/components/schemas/ChurchOut"
          },
          "message": {
            "title": "Message",
            "type": "string"
          }
        },
        "required": [
          "church",
          "already_member",
          "message"
        ],
        "title": "InviteAcceptOut",
        "type": "object"
      },
      "InviteCodeIn": {
        "additionalProperties": false,
        "description": "POST /invites/preview and /invites/accept: the code, only ever in the body (AC9).",
        "properties": {
          "code": {
            "default": "",
            "maxLength": 256,
            "title": "Code",
            "type": "string"
          }
        },
        "title": "InviteCodeIn",
        "type": "object"
      },
      "InvitePreviewOut": {
        "description": "What an invite offers. Never its id, code, church id, creator or bound email (F \u00a77.4).",
        "properties": {
          "already_member": {
            "title": "Already Member",
            "type": "boolean"
          },
          "church_name": {
            "title": "Church Name",
            "type": "string"
          },
          "email_bound": {
            "title": "Email Bound",
            "type": "boolean"
          },
          "expires_at": {
            "format": "date-time",
            "title": "Expires At",
            "type": "string"
          },
          "role": {
            "enum": [
              "member",
              "admin"
            ],
            "title": "Role",
            "type": "string"
          }
        },
        "required": [
          "church_name",
          "role",
          "expires_at",
          "email_bound",
          "already_member"
        ],
        "title": "InvitePreviewOut",
        "type": "object"
      },
      "LectionaryOut": {
        "description": "GET /lectionary/readings. `date` echoes the request and is never\nnormalized; `partial` means sets were found but one source failed;\n`default_index` is None exactly when `reading_sets` is empty.",
        "properties": {
          "date": {
            "format": "date",
            "title": "Date",
            "type": "string"
          },
          "default_index": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Default Index"
          },
          "partial": {
            "title": "Partial",
            "type": "boolean"
          },
          "reading_sets": {
            "items": {
              "$ref": "#/components/schemas/ReadingSetOut"
            },
            "title": "Reading Sets",
            "type": "array"
          },
          "status": {
            "enum": [
              "ok",
              "no_readings"
            ],
            "title": "Status",
            "type": "string"
          }
        },
        "required": [
          "date",
          "status",
          "partial",
          "reading_sets",
          "default_index"
        ],
        "title": "LectionaryOut",
        "type": "object"
      },
      "MeOut": {
        "properties": {
          "churches": {
            "items": {
              "$ref": "#/components/schemas/ChurchOut"
            },
            "title": "Churches",
            "type": "array"
          },
          "user": {
            "$ref": "#/components/schemas/UserOut"
          }
        },
        "required": [
          "user",
          "churches"
        ],
        "title": "MeOut",
        "type": "object"
      },
      "PassageOut": {
        "description": "One ref as sent (trimmed), with every section, whatever loaded.",
        "properties": {
          "reference": {
            "title": "Reference",
            "type": "string"
          },
          "sections": {
            "items": {
              "$ref": "#/components/schemas/PassageSectionOut"
            },
            "title": "Sections",
            "type": "array"
          },
          "status": {
            "enum": [
              "ok",
              "not_found",
              "unavailable"
            ],
            "title": "Status",
            "type": "string"
          }
        },
        "required": [
          "reference",
          "status",
          "sections"
        ],
        "title": "PassageOut",
        "type": "object"
      },
      "PassageSectionOut": {
        "description": "One \" or \" alternative: `ok` only when every part loaded; `text` joins the\nparts that did, or is null when none did (S Status rules).",
        "properties": {
          "reference": {
            "title": "Reference",
            "type": "string"
          },
          "status": {
            "enum": [
              "ok",
              "not_found",
              "unavailable"
            ],
            "title": "Status",
            "type": "string"
          },
          "text": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Text"
          }
        },
        "required": [
          "reference",
          "status",
          "text"
        ],
        "title": "PassageSectionOut",
        "type": "object"
      },
      "PassagesIn": {
        "additionalProperties": false,
        "description": "POST /scripture/passages. An empty list, a blank ref and more than 20\nparts in all are the usecase's 422s, with its exact messages (S Schemas).",
        "properties": {
          "refs": {
            "items": {
              "maxLength": 200,
              "type": "string"
            },
            "maxItems": 4,
            "title": "Refs",
            "type": "array"
          },
          "translation": {
            "maxLength": 20,
            "title": "Translation",
            "type": "string"
          }
        },
        "required": [
          "refs",
          "translation"
        ],
        "title": "PassagesIn",
        "type": "object"
      },
      "PassagesOut": {
        "properties": {
          "passages": {
            "items": {
              "$ref": "#/components/schemas/PassageOut"
            },
            "title": "Passages",
            "type": "array"
          },
          "translation": {
            "title": "Translation",
            "type": "string"
          },
          "translation_label": {
            "title": "Translation Label",
            "type": "string"
          }
        },
        "required": [
          "translation",
          "translation_label",
          "passages"
        ],
        "title": "PassagesOut",
        "type": "object"
      },
      "ReadingSetOut": {
        "description": "One set of readings. `scriptures` is in display order (first, psalm,\nsecond, gospel) with compound cells split; the usecase guarantees 1-20\nlines of 1-200 characters and a name of 1-300 (fits_draft_limits).",
        "properties": {
          "name": {
            "title": "Name",
            "type": "string"
          },
          "scriptures": {
            "items": {
              "type": "string"
            },
            "title": "Scriptures",
            "type": "array"
          },
          "source": {
            "enum": [
              "lectio",
              "vanderbilt",
              "merged"
            ],
            "title": "Source",
            "type": "string"
          }
        },
        "required": [
          "name",
          "scriptures",
          "source"
        ],
        "title": "ReadingSetOut",
        "type": "object"
      },
      "ReadyOut": {
        "properties": {
          "db": {
            "const": "ok",
            "title": "Db",
            "type": "string"
          },
          "ok": {
            "title": "Ok",
            "type": "boolean"
          }
        },
        "required": [
          "ok",
          "db"
        ],
        "title": "ReadyOut",
        "type": "object"
      },
      "RubricModel": {
        "properties": {
          "hymns": {
            "additionalProperties": {
              "items": {
                "type": "string"
              },
              "type": "array"
            },
            "title": "Hymns",
            "type": "object"
          },
          "prayers": {
            "additionalProperties": {
              "items": {
                "type": "string"
              },
              "type": "array"
            },
            "title": "Prayers",
            "type": "object"
          },
          "prefer_before_year": {
            "title": "Prefer Before Year",
            "type": "integer"
          },
          "prefer_familiar": {
            "title": "Prefer Familiar",
            "type": "boolean"
          }
        },
        "required": [
          "hymns",
          "prayers",
          "prefer_before_year",
          "prefer_familiar"
        ],
        "title": "RubricModel",
        "type": "object"
      },
      "RubricOut": {
        "properties": {
          "customized": {
            "items": {
              "type": "string"
            },
            "title": "Customized",
            "type": "array"
          },
          "rubric": {
            "$ref": "#/components/schemas/RubricModel"
          }
        },
        "required": [
          "rubric",
          "customized"
        ],
        "title": "RubricOut",
        "type": "object"
      },
      "UserOut": {
        "properties": {
          "email": {
            "title": "Email",
            "type": "string"
          },
          "id": {
            "format": "uuid",
            "title": "Id",
            "type": "string"
          },
          "name": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Name"
          },
          "picture": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Picture"
          }
        },
        "required": [
          "id",
          "email"
        ],
        "title": "UserOut",
        "type": "object"
      }
    }
  },
  "info": {
    "title": "Worship Service Builder API",
    "version": "0.1.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/church": {
      "get": {
        "operationId": "church_church_get",
        "parameters": [
          {
            "in": "header",
            "name": "x-church-id",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "X-Church-Id"
            }
          },
          {
            "in": "header",
            "name": "authorization",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Authorization"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ChurchOut"
                }
              }
            },
            "description": "Successful Response"
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            },
            "description": "Unauthorized"
          },
          "403": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            },
            "description": "Forbidden"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            },
            "description": "Unprocessable Entity"
          },
          "503": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            },
            "description": "Service Unavailable"
          }
        },
        "summary": "Church"
      }
    },
    "/churches": {
      "post": {
        "operationId": "create_church_churches_post",
        "parameters": [
          {
            "in": "header",
            "name": "authorization",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Authorization"
            }
          },
          {
            "in": "header",
            "name": "Idempotency-Key",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Idempotency-Key"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateChurchIn"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ChurchOut"
                }
              }
            },
            "description": "Successful Response"
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            },
            "description": "Unauthorized"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            },
            "description": "Unprocessable Entity"
          },
          "429": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            },
            "description": "Too Many Requests"
          },
          "503": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            },
            "description": "Service Unavailable"
          }
        },
        "summary": "Create Church"
      }
    },
    "/health": {
      "get": {
        "description": "Liveness: never touches the database. Railway's deploy health check is /health/ready (its Healthcheck Path setting).",
        "operationId": "health_health_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": true,
                  "title": "Response Health Health Get",
                  "type": "object"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Health"
      }
    },
    "/health/ready": {
      "get": {
        "description": "Readiness (Railway's deploy health check and keepalive.yml): 503 db_unavailable\nwhen, in production, the schema is behind this release, or when the database\nis not reachable. `ahead`, `unknown` and an unset state (no lifespan) pass.",
        "operationId": "ready_health_ready_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ReadyOut"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Ready"
      }
    },
    "/invites/accept": {
      "post": {
        "description": "Join the invite's church; for an existing member, a 200 that changes nothing.",
        "operationId": "accept_invite_invites_accept_post",
        "parameters": [
          {
            "in": "header",
            "name": "authorization",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Authorization"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/InviteCodeIn"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/InviteAcceptOut"
                }
              }
            },
            "description": "Successful Response"
          },
          "400": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            },
            "description": "Bad Request"
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            },
            "description": "Unauthorized"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            },
            "description": "Unprocessable Entity"
          },
          "503": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            },
            "description": "Service Unavailable"
          }
        },
        "summary": "Accept Invite"
      }
    },
    "/invites/preview": {
      "post": {
        "description": "What the invite offers (church, role, expiry) without joining: writes nothing.",
        "operationId": "preview_invite_invites_preview_post",
        "parameters": [
          {
            "in": "header",
            "name": "authorization",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Authorization"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/InviteCodeIn"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/InvitePreviewOut"
                }
              }
            },
            "description": "Successful Response"
          },
          "400": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            },
            "description": "Bad Request"
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            },
            "description": "Unauthorized"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            },
            "description": "Unprocessable Entity"
          },
          "503": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            },
            "description": "Service Unavailable"
          }
        },
        "summary": "Preview Invite"
      }
    },
    "/lectionary/readings": {
      "get": {
        "operationId": "lectionary_readings_lectionary_readings_get",
        "parameters": [
          {
            "in": "query",
            "name": "date",
            "required": true,
            "schema": {
              "format": "date",
              "title": "Date",
              "type": "string"
            }
          },
          {
            "in": "header",
            "name": "authorization",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Authorization"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/LectionaryOut"
                }
              }
            },
            "description": "Successful Response"
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            },
            "description": "Unauthorized"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            },
            "description": "Unprocessable Entity"
          },
          "429": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            },
            "description": "Too Many Requests"
          },
          "502": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            },
            "description": "Bad Gateway"
          },
          "503": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            },
            "description": "Service Unavailable"
          },
          "504": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            },
            "description": "Gateway Timeout"
          }
        },
        "summary": "Lectionary Readings"
      }
    },
    "/me": {
      "get": {
        "operationId": "me_me_get",
        "parameters": [
          {
            "in": "header",
            "name": "authorization",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Authorization"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MeOut"
                }
