{
  "components": {
    "schemas": {
      "ChurchOut": {
        "properties": {
          "id": {
            "format": "uuid",
            "title": "Id",
            "type": "string"
          },
          "name": {
            "title": "Name",
            "type": "string"
          },
          "role": {
            "enum": [
              "owner",
              "admin",
              "member"
            ],
            "title": "Role",
            "type": "string"
          }
        },
        "required": [
          "id",
          "name",
          "role"
        ],
        "title": "ChurchOut",
        "type": "object"
      },
      "CreateChurchIn": {
        "additionalProperties": false,
        "description": "The body of POST /churches. A blank name or time zone is left to the\nusecase, whose 422 names the field.",
        "properties": {
          "name": {
            "default": "",
            "maxLength": 200,
            "title": "Name",
            "type": "string"
          },
          "timezone": {
            "default": "",
            "maxLength": 64,
            "title": "Timezone",
            "type": "string"
          }
        },
        "title": "CreateChurchIn",
        "type": "object"
      },
      "ErrorBody": {
        "description": "Every error response's body (F \u00a71.5). `fields` and `details` are left out when absent.",
        "properties": {
          "error": {
            "$ref": "#/components/schemas/ErrorDetail"
          }
        },
        "required": [
          "error"
        ],
        "title": "ErrorBody",
        "type": "object"
      },
      "ErrorDetail": {
        "properties": {
          "code": {
            "title": "Code",
            "type": "string"
          },
          "details": {
            "anyOf": [
              {
                "additionalProperties": true,
                "type": "object"
              },
              {
                "type": "null"
              }
            ],
            "title": "Details"
          },
          "fields": {
            "anyOf": [
              {
                "additionalProperties": {
                  "type": "string"
                },
                "type": "object"
              },
              {
                "type": "null"
              }
            ],
            "title": "Fields"
          },
          "message": {
            "title": "Message",
            "type": "string"
          },
          "request_id": {
            "title": "Request Id",
            "type": "string"
          }
        },
        "required": [
          "code",
          "message",
          "request_id"
        ],
        "title": "ErrorDetail",
        "type": "object"
      },
      "InviteAcceptOut": {
        "properties": {
          "already_member": {
            "title": "Already Member",
            "type": "boolean"
          },
          "church": {
            "$ref": "#/components/schemas/ChurchOut"
          },
          "message": {
            "title": "Message",
            "type": "string"
          }
        },
        "required": [
          "church",
          "already_member",
          "message"
        ],
        "title": "InviteAcceptOut",
        "type": "object"
      },
      "InviteCodeIn": {
        "additionalProperties": false,
        "description": "POST /invites/preview and /invites/accept: the code, only ever in the body (AC9).",
        "properties": {
          "code": {
            "default": "",
            "maxLength": 256,
            "title": "Code",
            "type": "string"
          }
        },
        "title": "InviteCodeIn",
        "type": "object"
      },
      "InvitePreviewOut": {
        "description": "What an invite offers. Never its id, code, church id, creator or bound email (F \u00a77.4).",
        "properties": {
          "already_member": {
            "title": "Already Member",
            "type": "boolean"
          },
          "church_name": {
            "title": "Church Name",
            "type": "string"
          },
          "email_bound": {
            "title": "Email Bound",
            "type": "boolean"
          },
          "expires_at": {
            "format": "date-time",
            "title": "Expires At",
            "type": "string"
          },
          "role": {
            "enum": [
              "member",
              "admin"
            ],
            "title": "Role",
            "type": "string"
          }
        },
        "required": [
          "church_name",
          "role",
          "expires_at",
          "email_bound",
          "already_member"
        ],
        "title": "InvitePreviewOut",
        "type": "object"
      },
      "MeOut": {
        "properties": {
          "churches": {
            "items": {
              "$ref": "#/components/schemas/ChurchOut"
            },
            "title": "Churches",
            "type": "array"
          },
          "user": {
            "$ref": "#/components/schemas/UserOut"
          }
        },
        "required": [
          "user",
          "churches"
        ],
        "title": "MeOut",
        "type": "object"
      },
      "ReadyOut": {
        "properties": {
          "db": {
            "const": "ok",
            "title": "Db",
            "type": "string"
          },
          "ok": {
            "title": "Ok",
            "type": "boolean"
          }
        },
        "required": [
          "ok",
          "db"
        ],
        "title": "ReadyOut",
        "type": "object"
      },
      "RubricModel": {
        "properties": {
          "hymns": {
            "additionalProperties": {
              "items": {
                "type": "string"
              },
              "type": "array"
            },
            "title": "Hymns",
            "type": "object"
          },
          "prayers": {
            "additionalProperties": {
              "items": {
                "type": "string"
              },
              "type": "array"
            },
            "title": "Prayers",
            "type": "object"
          },
          "prefer_before_year": {
            "title": "Prefer Before Year",
            "type": "integer"
          },
          "prefer_familiar": {
            "title": "Prefer Familiar",
            "type": "boolean"
          }
        },
        "required": [
          "hymns",
          "prayers",
          "prefer_before_year",
          "prefer_familiar"
        ],
        "title": "RubricModel",
        "type": "object"
      },
      "RubricOut": {
        "properties": {
          "customized": {
            "items": {
              "type": "string"
            },
            "title": "Customized",
            "type": "array"
          },
          "rubric": {
            "$ref": "#/components/schemas/RubricModel"
          }
        },
        "required": [
          "rubric",
          "customized"
        ],
        "title": "RubricOut",
        "type": "object"
      },
      "UserOut": {
        "properties": {
          "email": {
            "title": "Email",
            "type": "string"
          },
          "id": {
            "format": "uuid",
            "title": "Id",
            "type": "string"
          },
          "name": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Name"
          },
          "picture": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Picture"
          }
        },
        "required": [
          "id",
          "email"
        ],
        "title": "UserOut",
        "type": "object"
      }
    }
  },
  "info": {
    "title": "Worship Service Builder API",
    "version": "0.1.0"
  },
